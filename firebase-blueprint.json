{
  "entities": {
    "CompanionBot": {
      "title": "CompanionBot",
      "description": "User-created or customized OpenClaw companion bot with Anpan-inspired SVG appearance and persona.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated owner UID."
        },
        "name": {
          "type": "string",
          "description": "Display name of the bot."
        },
        "roleTitle": {
          "type": "string",
          "description": "Short specialty subtitle for the bot."
        },
        "mission": {
          "type": "string",
          "description": "User-defined first-person mission for the bot (e.g., 'I help translate documents!')."
        },
        "lastMessagePreview": {
          "type": "string",
          "description": "Latest chat snippet displayed on the landing screen."
        },
        "archetype": {
          "type": "string",
          "enum": ["GLASSES_FELLOW", "PROFESSOR", "RETRO_ROBOT", "DINOSAUR", "GOBLIN", "YANKI_BIKER", "CHINESE_MASTER", "PIGTAIL_GIRL"],
          "description": "Base character style."
        },
        "hatStyle": {
          "type": "string",
          "enum": ["NONE", "BERET", "CAP", "PROPELLER", "MORTARBOARD", "CROWN", "HEADBAND", "ANTENNA_DISH"],
          "description": "Hat worn by the bot."
        },
        "accessoryStyle": {
          "type": "string",
          "enum": ["NONE", "FOREHEAD_GLASSES", "ROUND_GLASSES", "MONOCLE", "BOWTIE", "STUBBLE", "SCARF", "SPARK_BADGE"],
          "description": "Accessory or eyewear worn by the bot."
        },
        "primaryColorHex": {
          "type": "string",
          "description": "Hex color for face/chassis (#RRGGBB)."
        },
        "accentColorHex": {
          "type": "string",
          "description": "Hex color for nose/cheeks/trim (#RRGGBB)."
        },
        "systemPersona": {
          "type": "string",
          "description": "Custom persona prompt used when parsing casual requests."
        },
        "openClawAgentId": {
          "type": "string",
          "description": "Target OpenClaw agent identifier."
        },
        "functionPreset": {
          "type": "string",
          "enum": ["GENERAL", "TRANSLATION", "PROOFREADING", "CRITIQUING", "CODING", "RESEARCH"],
          "description": "Bot specialization passed to OpenClaw."
        },
        "llmProvider": {
          "type": "string",
          "enum": ["HOST_DEFAULT", "OPENCLAW_AUTO", "VENICE_AI", "GOOGLE", "LOCAL_LLM"],
          "description": "Preferred OpenClaw LLM provider for this bot."
        },
        "llmModel": {
          "type": "string",
          "description": "Optional explicit OpenClaw model ID."
        },
        "openClawSynced": {
          "type": "boolean",
          "description": "Whether the bot profile has been synced to the OpenClaw host."
        },
        "pinnedDefault": {
          "type": "boolean",
          "description": "Whether this is a starter/pinned bot."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "name",
        "roleTitle",
        "archetype",
        "hatStyle",
        "accessoryStyle",
        "primaryColorHex",
        "accentColorHex",
        "systemPersona",
        "openClawAgentId",
        "pinnedDefault",
        "createdAt",
        "updatedAt"
      ]
    },
    "BotMessage": {
      "title": "BotMessage",
      "description": "Message in a bot chat thread, including parsed OpenClaw instruction, facial expression state, and attachments.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated owner UID."
        },
        "botId": {
          "type": "string",
          "description": "Parent companion bot document ID."
        },
        "sender": {
          "type": "string",
          "enum": ["USER", "BOT", "SYSTEM"],
          "description": "Sender role."
        },
        "rawText": {
          "type": "string",
          "description": "Casual user message or bot response text."
        },
        "parsedInstruction": {
          "type": "string",
          "description": "Clear structured OpenClaw instruction parsed from casual chat."
        },
        "instructionGoal": {
          "type": "string",
          "description": "Short 1-line summary of the instruction goal."
        },
        "instructionSteps": {
          "type": "array",
          "description": "Ordered step-by-step actions for OpenClaw (max 12)."
        },
        "expression": {
          "type": "string",
          "enum": ["HAPPY", "THINKING", "UH_HUH", "WORRIED", "SORRY", "WORKING", "ALERT"],
          "description": "Facial expression triggered on the bot."
        },
        "status": {
          "type": "string",
          "enum": ["IDLE", "PARSING", "DISPATCHED", "COMPLETED", "WARNING", "FAILED"],
          "description": "Execution status."
        },
        "attachedFiles": {
          "type": "array",
          "description": "Attached local file labels (max 10)."
        },
        "linkedPaths": {
          "type": "array",
          "description": "Linked host paths or URIs (max 10)."
        },
        "takeoverSuggested": {
          "type": "boolean",
          "description": "Whether taking over the OpenClaw host computer is suggested."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "botId",
        "sender",
        "rawText",
        "instructionSteps",
        "expression",
        "status",
        "attachedFiles",
        "linkedPaths",
        "takeoverSuggested",
        "createdAt",
        "updatedAt"
      ]
    },
    "OpenClawHost": {
      "title": "OpenClawHost",
      "description": "Saved OpenClaw host computer connection profile for gateway API and computer takeover.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated owner UID."
        },
        "label": {
          "type": "string",
          "description": "Friendly host computer label."
        },
        "baseUrl": {
          "type": "string",
          "description": "OpenClaw gateway base URL."
        },
        "controlUrl": {
          "type": "string",
          "description": "Remote desktop / browser takeover URL for the host."
        },
        "gatewayToken": {
          "type": "string",
          "description": "Optional bearer token for the OpenClaw gateway."
        },
        "aiMode": {
          "type": "string",
          "enum": ["HYBRID_GEMINI_OPENCLAW", "OPENCLAW_ONLY", "GEMINI_PARSER_PREVIEW"],
          "description": "Routing mode for casual-to-instruction parsing and execution."
        },
        "defaultLlmProvider": {
          "type": "string",
          "enum": ["OPENCLAW_AUTO", "VENICE_AI", "GOOGLE", "LOCAL_LLM"],
          "description": "Default OpenClaw LLM provider (Venice.ai, Google, Local LLM, or Gateway Default)."
        },
        "defaultLlmModel": {
          "type": "string",
          "description": "Default OpenClaw model identifier."
        },
        "localLlmEndpoint": {
          "type": "string",
          "description": "Optional local LLM endpoint URL on the host machine."
        },
        "autoParseCasual": {
          "type": "boolean",
          "description": "Whether to parse casual chat into clear OpenClaw instructions automatically."
        },
        "lastStatus": {
          "type": "string",
          "enum": ["ONLINE", "OFFLINE", "UNVERIFIED"],
          "description": "Last verified gateway reachability status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "label",
        "baseUrl",
        "controlUrl",
        "gatewayToken",
        "aiMode",
        "autoParseCasual",
        "lastStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "LinkedFile": {
      "title": "LinkedFile",
      "description": "Saved file attachment or host file link reference.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated owner UID."
        },
        "displayName": {
          "type": "string",
          "description": "Display filename."
        },
        "uriOrPath": {
          "type": "string",
          "description": "SAF URI, URL, or host computer path."
        },
        "linkType": {
          "type": "string",
          "enum": ["ANDROID_ATTACHMENT", "HOST_PATH", "CLOUD_URL"],
          "description": "Source type of the file link."
        },
        "mimeOrExt": {
          "type": "string",
          "description": "MIME type or file extension."
        },
        "sizeBytes": {
          "type": "integer",
          "description": "File size in bytes if known."
        },
        "notes": {
          "type": "string",
          "description": "User note or context about the file."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "displayName",
        "uriOrPath",
        "linkType",
        "mimeOrExt",
        "sizeBytes",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "Multi-bot collaborative cafe room where multiple bots interact with each other and the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated owner UID." },
        "title": { "type": "string", "description": "Chat room name." },
        "topic": { "type": "string", "description": "Room mission or workflow summary." },
        "botIds": { "type": "array", "description": "Participant bot document IDs." },
        "lastMessagePreview": { "type": "string", "description": "Latest room activity preview." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "topic", "botIds", "lastMessagePreview", "createdAt", "updatedAt"]
    },
    "RoomMessage": {
      "title": "RoomMessage",
      "description": "Message inside a multi-bot chat room.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "roomId": { "type": "string" },
        "senderType": { "type": "string", "enum": ["USER", "BOT", "SYSTEM"] },
        "senderBotId": { "type": "string" },
        "senderBotName": { "type": "string" },
        "replyToBotName": { "type": "string" },
        "rawText": { "type": "string" },
        "parsedInstruction": { "type": "string" },
        "expression": { "type": "string", "enum": ["HAPPY", "THINKING", "UH_HUH", "WORRIED", "SORRY", "WORKING", "ALERT"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "roomId", "senderType", "senderBotName", "rawText", "expression", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/bots/{botId}": {
      "schema": { "$ref": "#/entities/CompanionBot" },
      "description": "User-owned companion bots."
    },
    "/users/{userId}/bots/{botId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/BotMessage" },
      "description": "Conversation messages and parsed OpenClaw instructions for a bot."
    },
    "/users/{userId}/chatRooms/{roomId}": {
      "schema": { "$ref": "#/entities/ChatRoom" },
      "description": "Multi-bot collaborative cafe chat rooms."
    },
    "/users/{userId}/chatRooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/RoomMessage" },
      "description": "Multi-bot interaction messages inside a chat room."
    },
    "/users/{userId}/hosts/{hostId}": {
      "schema": { "$ref": "#/entities/OpenClawHost" },
      "description": "Saved OpenClaw host computer profiles."
    },
    "/users/{userId}/linkedFiles/{fileId}": {
      "schema": { "$ref": "#/entities/LinkedFile" },
      "description": "User-attached files and linked host file paths."
    }
  }
}
