{
  "entities": {
    "CompanionBot": {
      "title": "CompanionBot",
      "description": "User-created or customized OpenClaw companion bot with Anpan-inspired SVG appearance and persona.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated owner UID."
        },
        "name": {
          "type": "string",
          "description": "Display name of the bot."
        },
        "roleTitle": {
          "type": "string",
          "description": "Short specialty subtitle for the bot."
        },
        "mission": {
          "type": "string",
          "description": "User-defined first-person mission for the bot (e.g., 'I help translate documents!')."
        },
        "lastMessagePreview": {
          "type": "string",
          "description": "Latest chat snippet displayed on the landing screen."
        },
        "archetype": {
          "type": "string",
          "enum": ["GLASSES_FELLOW", "PROFESSOR", "RETRO_ROBOT", "DINOSAUR", "GOBLIN", "YANKI_BIKER", "CHINESE_MASTER", "PIGTAIL_GIRL"],
          "description": "Base character style."
        },
        "hatStyle": {
          "type": "string",
          "enum": ["NONE", "BERET", "CAP", "PROPELLER", "MORTARBOARD", "CROWN", "HEADBAND", "ANTENNA_DISH"],
          "description": "Hat worn by the bot."
        },
        "accessoryStyle": {
          "type": "string",
          "enum": ["NONE", "FOREHEAD_GLASSES", "ROUND_GLASSES", "MONOCLE", "BOWTIE", "STUBBLE", "SCARF", "SPARK_BADGE"],
          "description": "Accessory or eyewear worn by the bot."
        },
        "primaryColorHex": {
          "type": "string",
          "description": "Hex color for face/chassis (#RRGGBB)."
        },
        "accentColorHex": {
          "type": "string",
          "description": "Hex color for nose/cheeks/trim (#RRGGBB)."
        },
        "systemPersona": {
          "type": "string",
          "description": "Custom persona prompt used when parsing casual requests."
        },
        "openClawAgentId": {
          "type": "string",
          "description": "Target OpenClaw agent identifier."
        },
        "sessionKey": {
          "type": "string",
          "description": "Isolated OpenClaw session key (e.g., agent:<bot_dude_id>:main)."
        },
        "toolPermissions": {
          "type": "array",
          "description": "Enabled tool/workspace capability keys for this Bot Dude."
        },
        "workspacePath": {
          "type": "string",
          "description": "Optional isolated workspace path on the OpenClaw host."
        },
        "functionPreset": {
          "type": "string",
          "enum": ["GENERAL", "TRANSLATION", "PROOFREADING", "CRITIQUING", "CODING", "RESEARCH"],
          "description": "Bot specialization passed to OpenClaw."
        },
        "llmProvider": {
          "type": "string",
          "enum": ["HOST_DEFAULT", "OPENCLAW_AUTO", "VENICE_AI", "GOOGLE", "LOCAL_LLM"],
          "description": "Preferred OpenClaw LLM provider override for this bot."
        },
        "llmModel": {
          "type": "string",
          "description": "Optional explicit OpenClaw/Venice model ID override."
        },
        "openClawSynced": {
          "type": "boolean",
          "description": "Whether the bot profile has been synced to the OpenClaw host."
        },
        "pinnedDefault": {
          "type": "boolean",
          "description": "Whether this is a starter/pinned bot."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "name",
        "roleTitle",
        "archetype",
        "hatStyle",
        "accessoryStyle",
        "primaryColorHex",
        "accentColorHex",
        "systemPersona",
        "openClawAgentId",
        "pinnedDefault",
        "createdAt",
        "updatedAt"
      ]
    },
    "BotMessage": {
      "title": "BotMessage",
      "description": "Message in a bot chat thread, including parsed OpenClaw instruction, facial expression state, attachments, and optional generated media.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "botId": { "type": "string" },
        "sender": { "type": "string", "enum": ["USER", "BOT", "SYSTEM"] },
        "rawText": { "type": "string" },
        "parsedInstruction": { "type": "string" },
        "instructionGoal": { "type": "string" },
        "instructionSteps": { "type": "array" },
        "expression": { "type": "string", "enum": ["HAPPY", "THINKING", "UH_HUH", "WORRIED", "SORRY", "WORKING", "ALERT"] },
        "status": { "type": "string", "enum": ["IDLE", "PARSING", "DISPATCHED", "COMPLETED", "WARNING", "FAILED"] },
        "attachedFiles": { "type": "array" },
        "linkedPaths": { "type": "array" },
        "takeoverSuggested": { "type": "boolean" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["IMAGE", "VIDEO", "AUDIO", "DOCUMENT"] },
        "mediaPrompt": { "type": "string" },
        "mediaModel": { "type": "string" },
        "mediaDurationSec": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "botId", "sender", "rawText", "instructionSteps",
        "expression", "status", "attachedFiles", "linkedPaths",
        "takeoverSuggested", "createdAt", "updatedAt"
      ]
    },
    "OpenClawHost": {
      "title": "OpenClawHost",
      "description": "Saved OpenClaw host computer connection profile for gateway API and computer takeover.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "label": { "type": "string" },
        "baseUrl": { "type": "string" },
        "lanUrl": { "type": "string" },
        "tailscaleUrl": { "type": "string" },
        "connectionMode": { "type": "string", "enum": ["LAN", "TAILSCALE"] },
        "controlUrl": { "type": "string" },
        "gatewayToken": { "type": "string" },
        "aiMode": { "type": "string", "enum": ["HYBRID_GEMINI_OPENCLAW", "OPENCLAW_ONLY", "GEMINI_PARSER_PREVIEW"] },
        "defaultLlmProvider": { "type": "string", "enum": ["OPENCLAW_AUTO", "VENICE_AI", "GOOGLE", "LOCAL_LLM"] },
        "defaultLlmModel": { "type": "string" },
        "localLlmEndpoint": { "type": "string" },
        "autoParseCasual": { "type": "boolean" },
        "lastStatus": { "type": "string", "enum": ["ONLINE", "OFFLINE", "UNVERIFIED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "label", "baseUrl", "controlUrl", "gatewayToken",
        "aiMode", "autoParseCasual", "lastStatus", "createdAt", "updatedAt"
      ]
    },
    "LinkedFile": {
      "title": "LinkedFile",
      "description": "Saved file attachment or host file link reference.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "uriOrPath": { "type": "string" },
        "linkType": { "type": "string", "enum": ["ANDROID_ATTACHMENT", "HOST_PATH", "CLOUD_URL"] },
        "mimeOrExt": { "type": "string" },
        "sizeBytes": { "type": "integer" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "displayName", "uriOrPath", "linkType",
        "mimeOrExt", "sizeBytes", "notes", "createdAt", "updatedAt"
      ]
    },
    "GeneratedMediaItem": {
      "title": "GeneratedMediaItem",
      "description": "AI-generated image or video returned by OpenClaw / Venice.ai and archived in the user's Files gallery.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["IMAGE", "VIDEO", "AUDIO", "DOCUMENT"] },
        "prompt": { "type": "string" },
        "modelUsed": { "type": "string" },
        "durationSec": { "type": "integer" },
        "sourceBotName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "mediaUrl", "mediaType", "prompt", "modelUsed",
        "durationSec", "sourceBotName", "createdAt", "updatedAt"
      ]
    },
    "UserVenicePreferences": {
      "title": "UserVenicePreferences",
      "description": "Synced global Venice.ai model slug and optional API key override for the signed-in user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "globalVeniceModel": { "type": "string" },
        "veniceApiKeyOverride": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "globalVeniceModel", "veniceApiKeyOverride", "createdAt", "updatedAt"
      ]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "Multi-bot collaborative cafe room where multiple bots interact with each other and the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "topic": { "type": "string" },
        "botIds": { "type": "array" },
        "maxPingPongTurns": { "type": "integer", "description": "Maximum autonomous A2A bot turns per Cafe round." },
        "lastMessagePreview": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "topic", "botIds", "lastMessagePreview", "createdAt", "updatedAt"]
    },
    "RoomMessage": {
      "title": "RoomMessage",
      "description": "Message inside a multi-bot chat room.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "roomId": { "type": "string" },
        "senderType": { "type": "string", "enum": ["USER", "BOT", "SYSTEM"] },
        "senderBotId": { "type": "string" },
        "senderBotName": { "type": "string" },
        "replyToBotName": { "type": "string" },
        "rawText": { "type": "string" },
        "parsedInstruction": { "type": "string" },
        "expression": { "type": "string", "enum": ["HAPPY", "THINKING", "UH_HUH", "WORRIED", "SORRY", "WORKING", "ALERT"] },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["IMAGE", "VIDEO", "AUDIO", "DOCUMENT"] },
        "mediaPrompt": { "type": "string" },
        "mediaModel": { "type": "string" },
        "mediaDurationSec": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "roomId", "senderType", "senderBotName", "rawText", "expression", "createdAt", "updatedAt"]
    },
    "GeneralChatThread": {
      "title": "GeneralChatThread",
      "description": "General everyday Q&A chat thread (non-specialized, accessible like Gemini chat history).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "pinned": { "type": "boolean" },
        "lastMessagePreview": { "type": "string" },
        "wheelModel": {
          "type": "string",
          "enum": ["OPENCLAW_DEFAULT", "OPENCLAW_LOCAL", "OPENCLAW_THIRD_PARTY"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "pinned", "lastMessagePreview", "wheelModel", "createdAt", "updatedAt"]
    },
    "GeneralChatMessage": {
      "title": "GeneralChatMessage",
      "description": "Message inside a general everyday Q&A chat thread.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "chatId": { "type": "string" },
        "sender": { "type": "string", "enum": ["USER", "BOT", "SYSTEM"] },
        "rawText": { "type": "string" },
        "modelLabel": { "type": "string" },
        "status": { "type": "string", "enum": ["IDLE", "PARSING", "DISPATCHED", "COMPLETED", "WARNING", "FAILED"] },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["IMAGE", "VIDEO", "AUDIO", "DOCUMENT"] },
        "mediaPrompt": { "type": "string" },
        "mediaModel": { "type": "string" },
        "mediaDurationSec": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "chatId", "sender", "rawText", "modelLabel", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/bots/{botId}": {
      "schema": { "$ref": "#/entities/CompanionBot" },
      "description": "User-owned companion bots."
    },
    "/users/{userId}/bots/{botId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/BotMessage" },
      "description": "Conversation messages and parsed OpenClaw instructions for a bot."
    },
    "/users/{userId}/chatRooms/{roomId}": {
      "schema": { "$ref": "#/entities/ChatRoom" },
      "description": "Multi-bot collaborative cafe chat rooms."
    },
    "/users/{userId}/chatRooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/RoomMessage" },
      "description": "Multi-bot interaction messages inside a chat room."
    },
    "/users/{userId}/generalChats/{chatId}": {
      "schema": { "$ref": "#/entities/GeneralChatThread" },
      "description": "General everyday Q&A chat threads."
    },
    "/users/{userId}/generalChats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/GeneralChatMessage" },
      "description": "Messages inside a general Q&A chat thread."
    },
    "/users/{userId}/hosts/{hostId}": {
      "schema": { "$ref": "#/entities/OpenClawHost" },
      "description": "Saved OpenClaw host computer profiles."
    },
    "/users/{userId}/linkedFiles/{fileId}": {
      "schema": { "$ref": "#/entities/LinkedFile" },
      "description": "User-attached files and linked host file paths."
    },
    "/users/{userId}/generatedMedia/{mediaId}": {
      "schema": { "$ref": "#/entities/GeneratedMediaItem" },
      "description": "Generated images & videos returned from OpenClaw / Venice.ai."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserVenicePreferences" },
      "description": "Synced global Venice.ai model & optional API key override."
    }
  }
}
