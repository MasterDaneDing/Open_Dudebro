rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Shared Security Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidHexColor(hex) {
      return hex is string && hex.size() == 7 && hex.matches('^#[0-9A-Fa-f]{6}$');
    }

    function isValidStringList(lst, maxItems, maxItemLen) {
      return lst is list &&
             lst.size() <= maxItems &&
             (lst.size() == 0 || (lst[0] is string && lst[0].size() <= maxItemLen));
    }

    function isValidOptionalMediaFields(data) {
      return (!('mediaUrl' in data) || data.mediaUrl == null || (data.mediaUrl is string && data.mediaUrl.size() <= 1500)) &&
             (!('mediaType' in data) || data.mediaType == null || data.mediaType in ['IMAGE', 'VIDEO', 'AUDIO', 'DOCUMENT']) &&
             (!('mediaPrompt' in data) || data.mediaPrompt == null || (data.mediaPrompt is string && data.mediaPrompt.size() <= 1000)) &&
             (!('mediaModel' in data) || data.mediaModel == null || (data.mediaModel is string && data.mediaModel.size() <= 120)) &&
             (!('mediaDurationSec' in data) || data.mediaDurationSec == null || (data.mediaDurationSec is int && data.mediaDurationSec >= 0 && data.mediaDurationSec <= 600));
    }

    // --- Entity Validation Helpers ---
    function isValidCompanionBot(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 40 &&
             data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 60 &&
             data.archetype in [
               'GLASSES_FELLOW', 'PROFESSOR', 'RETRO_ROBOT', 'DINOSAUR',
               'GOBLIN', 'YANKI_BIKER', 'CHINESE_MASTER', 'PIGTAIL_GIRL'
             ] &&
             data.hatStyle in ['NONE', 'BERET', 'CAP', 'PROPELLER', 'MORTARBOARD', 'CROWN', 'HEADBAND', 'ANTENNA_DISH'] &&
             data.accessoryStyle in ['NONE', 'FOREHEAD_GLASSES', 'ROUND_GLASSES', 'MONOCLE', 'BOWTIE', 'STUBBLE', 'SCARF', 'SPARK_BADGE'] &&
             isValidHexColor(data.primaryColorHex) &&
             isValidHexColor(data.accentColorHex) &&
             data.systemPersona is string && data.systemPersona.size() <= 500 &&
             (!('mission' in data) || (data.mission is string && data.mission.size() <= 160)) &&
             (!('lastMessagePreview' in data) || (data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300)) &&
             data.openClawAgentId is string && data.openClawAgentId.size() <= 80 &&
             (!('functionPreset' in data) || data.functionPreset in ['GENERAL', 'TRANSLATION', 'PROOFREADING', 'CRITIQUING', 'CODING', 'RESEARCH']) &&
             (!('llmProvider' in data) || data.llmProvider in ['HOST_DEFAULT', 'OPENCLAW_AUTO', 'VENICE_AI', 'GOOGLE', 'LOCAL_LLM']) &&
             (!('llmModel' in data) || (data.llmModel is string && data.llmModel.size() <= 120)) &&
             (!('sessionKey' in data) || (data.sessionKey is string && data.sessionKey.size() <= 160)) &&
             (!('workspacePath' in data) || (data.workspacePath is string && data.workspacePath.size() <= 300)) &&
             (!('toolPermissions' in data) || isValidStringList(data.toolPermissions, 12, 40)) &&
             (!('openClawSynced' in data) || data.openClawSynced is bool) &&
             data.pinnedDefault is bool;
    }

    function isValidChatRoom(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 60 &&
             data.topic is string && data.topic.size() <= 160 &&
             isValidStringList(data.botIds, 8, 128) &&
             data.botIds.size() >= 1 &&
             (!('maxPingPongTurns' in data) || (data.maxPingPongTurns is int && data.maxPingPongTurns >= 1 && data.maxPingPongTurns <= 8)) &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300;
    }

    function isValidRoomMessage(data, userId, roomId) {
      return data.userId is string && data.userId == userId &&
             data.roomId is string && data.roomId == roomId &&
             data.senderType in ['USER', 'BOT', 'SYSTEM'] &&
             (!('senderBotId' in data) || data.senderBotId == null || (data.senderBotId is string && data.senderBotId.size() <= 128)) &&
             data.senderBotName is string && data.senderBotName.size() >= 1 && data.senderBotName.size() <= 50 &&
             (!('replyToBotName' in data) || data.replyToBotName == null || (data.replyToBotName is string && data.replyToBotName.size() <= 50)) &&
             data.rawText is string && data.rawText.size() >= 1 && data.rawText.size() <= 4000 &&
             (!('parsedInstruction' in data) || data.parsedInstruction == null || (data.parsedInstruction is string && data.parsedInstruction.size() <= 4000)) &&
             data.expression in ['HAPPY', 'THINKING', 'UH_HUH', 'WORRIED', 'SORRY', 'WORKING', 'ALERT'] &&
             isValidOptionalMediaFields(data);
    }

    function isValidBotMessage(data, userId, botId) {
      return data.userId is string && data.userId == userId &&
             data.botId is string && data.botId == botId &&
             data.sender in ['USER', 'BOT', 'SYSTEM'] &&
             data.rawText is string && data.rawText.size() >= 1 && data.rawText.size() <= 4000 &&
             (!('parsedInstruction' in data) || data.parsedInstruction == null || (data.parsedInstruction is string && data.parsedInstruction.size() <= 4000)) &&
             (!('instructionGoal' in data) || data.instructionGoal == null || (data.instructionGoal is string && data.instructionGoal.size() <= 200)) &&
             isValidStringList(data.instructionSteps, 12, 300) &&
             data.expression in ['HAPPY', 'THINKING', 'UH_HUH', 'WORRIED', 'SORRY', 'WORKING', 'ALERT'] &&
             data.status in ['IDLE', 'PARSING', 'DISPATCHED', 'COMPLETED', 'WARNING', 'FAILED'] &&
             isValidStringList(data.attachedFiles, 10, 200) &&
             isValidStringList(data.linkedPaths, 10, 500) &&
             data.takeoverSuggested is bool &&
             isValidOptionalMediaFields(data);
    }

    function isValidOpenClawHost(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 50 &&
             data.baseUrl is string && data.baseUrl.size() >= 1 && data.baseUrl.size() <= 300 &&
             (!('lanUrl' in data) || (data.lanUrl is string && data.lanUrl.size() <= 300)) &&
             (!('tailscaleUrl' in data) || (data.tailscaleUrl is string && data.tailscaleUrl.size() <= 300)) &&
             (!('connectionMode' in data) || data.connectionMode in ['LAN', 'TAILSCALE']) &&
             data.controlUrl is string && data.controlUrl.size() <= 300 &&
             data.gatewayToken is string && data.gatewayToken.size() <= 256 &&
             data.aiMode in ['HYBRID_GEMINI_OPENCLAW', 'OPENCLAW_ONLY', 'GEMINI_PARSER_PREVIEW'] &&
             (!('defaultLlmProvider' in data) || data.defaultLlmProvider in ['OPENCLAW_AUTO', 'VENICE_AI', 'GOOGLE', 'LOCAL_LLM']) &&
             (!('defaultLlmModel' in data) || (data.defaultLlmModel is string && data.defaultLlmModel.size() <= 120)) &&
             (!('localLlmEndpoint' in data) || (data.localLlmEndpoint is string && data.localLlmEndpoint.size() <= 300)) &&
             data.autoParseCasual is bool &&
             data.lastStatus in ['ONLINE', 'OFFLINE', 'UNVERIFIED'];
    }

    function isValidLinkedFile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
             data.uriOrPath is string && data.uriOrPath.size() >= 1 && data.uriOrPath.size() <= 500 &&
             data.linkType in ['ANDROID_ATTACHMENT', 'HOST_PATH', 'CLOUD_URL'] &&
             data.mimeOrExt is string && data.mimeOrExt.size() <= 120 &&
             data.sizeBytes is int && data.sizeBytes >= 0 &&
             data.notes is string && data.notes.size() <= 250;
    }

    function isValidGeneratedMedia(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.mediaUrl is string && data.mediaUrl.size() >= 1 && data.mediaUrl.size() <= 1500 &&
             data.mediaType in ['IMAGE', 'VIDEO', 'AUDIO', 'DOCUMENT'] &&
             data.prompt is string && data.prompt.size() <= 1000 &&
             data.modelUsed is string && data.modelUsed.size() <= 120 &&
             data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 600 &&
             data.sourceBotName is string && data.sourceBotName.size() <= 60;
    }

    function isValidUserPreferences(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.globalVeniceModel is string && data.globalVeniceModel.size() >= 1 && data.globalVeniceModel.size() <= 120 &&
             data.veniceApiKeyOverride is string && data.veniceApiKeyOverride.size() <= 256;
    }

    function isValidGeneralChat(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.pinned is bool &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300 &&
             data.wheelModel in ['OPENCLAW_DEFAULT', 'OPENCLAW_LOCAL', 'OPENCLAW_THIRD_PARTY'];
    }

    function isValidGeneralMessage(data, userId, chatId) {
      return data.userId is string && data.userId == userId &&
             data.chatId is string && data.chatId == chatId &&
             data.sender in ['USER', 'BOT', 'SYSTEM'] &&
             data.rawText is string && data.rawText.size() >= 1 && data.rawText.size() <= 4000 &&
             data.modelLabel is string && data.modelLabel.size() <= 80 &&
             data.status in ['IDLE', 'PARSING', 'DISPATCHED', 'COMPLETED', 'WARNING', 'FAILED'] &&
             isValidOptionalMediaFields(data);
    }

    function isValidContextChat(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.pinned is bool &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300 &&
             data.wheelModel in ['OPENCLAW_DEFAULT', 'OPENCLAW_LOCAL', 'OPENCLAW_THIRD_PARTY'] &&
             isValidStringList(data.docLabels, 20, 120) &&
             isValidStringList(data.docRefs, 20, 500);
    }

    function isValidContextMessage(data, userId, chatId) {
      return data.userId is string && data.userId == userId &&
             data.chatId is string && data.chatId == chatId &&
             data.sender in ['USER', 'BOT', 'SYSTEM'] &&
             data.rawText is string && data.rawText.size() >= 1 && data.rawText.size() <= 4000 &&
             data.modelLabel is string && data.modelLabel.size() <= 80 &&
             data.status in ['IDLE', 'PARSING', 'DISPATCHED', 'COMPLETED', 'WARNING', 'FAILED'] &&
             isValidStringList(data.citedDocs, 20, 120) &&
             isValidOptionalMediaFields(data);
    }

    // --- Collection Rules ---
    match /users/{userId}/bots/{botId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(botId);

      allow create: if isOwner(userId) &&
                       isValidId(botId) &&
                       incoming().keys().hasAll([
                         'userId', 'name', 'roleTitle', 'archetype', 'hatStyle',
                         'accessoryStyle', 'primaryColorHex', 'accentColorHex',
                         'systemPersona', 'openClawAgentId', 'pinnedDefault',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'name', 'roleTitle', 'archetype', 'hatStyle',
                         'accessoryStyle', 'primaryColorHex', 'accentColorHex',
                         'systemPersona', 'mission', 'lastMessagePreview',
                         'openClawAgentId', 'sessionKey', 'toolPermissions', 'workspacePath',
                         'functionPreset', 'llmProvider',
                         'llmModel', 'openClawSynced', 'pinnedDefault',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       isValidCompanionBot(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(botId) &&
                       isValidCompanionBot(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'name', 'roleTitle', 'archetype', 'hatStyle',
                         'accessoryStyle', 'primaryColorHex', 'accentColorHex',
                         'systemPersona', 'mission', 'lastMessagePreview',
                         'openClawAgentId', 'sessionKey', 'toolPermissions', 'workspacePath',
                         'functionPreset', 'llmProvider',
                         'llmModel', 'openClawSynced', 'pinnedDefault', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(botId);

      match /messages/{messageId} {
        allow list: if isOwner(userId) && isValidId(botId);
        allow get: if isOwner(userId) && isValidId(botId) && isValidId(messageId);

        allow create: if isOwner(userId) &&
                         isValidId(botId) &&
                         isValidId(messageId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/bots/$(botId)) &&
                         incoming().keys().hasAll([
                           'userId', 'botId', 'sender', 'rawText',
                           'instructionSteps', 'expression', 'status',
                           'attachedFiles', 'linkedPaths', 'takeoverSuggested',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'botId', 'sender', 'rawText',
                           'parsedInstruction', 'instructionGoal', 'instructionSteps',
                           'expression', 'status', 'attachedFiles', 'linkedPaths',
                           'takeoverSuggested', 'mediaUrl', 'mediaType',
                           'mediaPrompt', 'mediaModel', 'mediaDurationSec',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt) &&
                         isValidBotMessage(incoming(), userId, botId);

        allow update: if isOwner(userId) &&
                         isValidId(botId) &&
                         isValidId(messageId) &&
                         isValidBotMessage(incoming(), userId, botId) &&
                         incoming().userId == existing().userId &&
                         incoming().botId == existing().botId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'rawText', 'parsedInstruction', 'instructionGoal',
                           'instructionSteps', 'expression', 'status',
                           'takeoverSuggested', 'mediaUrl', 'mediaType',
                           'mediaPrompt', 'mediaModel', 'mediaDurationSec', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(botId) && isValidId(messageId);
      }
    }

    match /users/{userId}/chatRooms/{roomId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(roomId);

      allow create: if isOwner(userId) &&
                       isValidId(roomId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'topic', 'botIds',
                         'lastMessagePreview', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'topic', 'botIds',
                         'maxPingPongTurns', 'lastMessagePreview', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       isValidChatRoom(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(roomId) &&
                       isValidChatRoom(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'topic', 'botIds', 'maxPingPongTurns', 'lastMessagePreview', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(roomId);

      match /messages/{messageId} {
        allow list: if isOwner(userId) && isValidId(roomId);
        allow get: if isOwner(userId) && isValidId(roomId) && isValidId(messageId);

        allow create: if isOwner(userId) &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/chatRooms/$(roomId)) &&
                         incoming().keys().hasAll([
                           'userId', 'roomId', 'senderType', 'senderBotName',
                           'rawText', 'expression', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'roomId', 'senderType', 'senderBotId',
                           'senderBotName', 'replyToBotName', 'rawText',
                           'parsedInstruction', 'expression',
                           'mediaUrl', 'mediaType', 'mediaPrompt',
                           'mediaModel', 'mediaDurationSec',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt) &&
                         isValidRoomMessage(incoming(), userId, roomId);

        allow update: if isOwner(userId) &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         isValidRoomMessage(incoming(), userId, roomId) &&
                         incoming().userId == existing().userId &&
                         incoming().roomId == existing().roomId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'rawText', 'parsedInstruction', 'expression',
                           'mediaUrl', 'mediaType', 'mediaPrompt',
                           'mediaModel', 'mediaDurationSec', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(roomId) && isValidId(messageId);
      }
    }

    match /users/{userId}/hosts/{hostId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(hostId);

      allow create: if isOwner(userId) &&
                       isValidId(hostId) &&
                       incoming().keys().hasAll([
                         'userId', 'label', 'baseUrl', 'controlUrl', 'gatewayToken',
                         'aiMode', 'autoParseCasual', 'lastStatus', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'label', 'baseUrl', 'lanUrl', 'tailscaleUrl', 'connectionMode',
                         'controlUrl', 'gatewayToken', 'aiMode', 'defaultLlmProvider', 'defaultLlmModel',
                         'localLlmEndpoint', 'autoParseCasual', 'lastStatus',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       isValidOpenClawHost(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(hostId) &&
                       isValidOpenClawHost(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'label', 'baseUrl', 'lanUrl', 'tailscaleUrl', 'connectionMode',
                         'controlUrl', 'gatewayToken', 'aiMode', 'defaultLlmProvider', 'defaultLlmModel',
                         'localLlmEndpoint', 'autoParseCasual', 'lastStatus', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(hostId);
    }

    match /users/{userId}/linkedFiles/{fileId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(fileId);

      allow create: if isOwner(userId) &&
                       isValidId(fileId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'uriOrPath', 'linkType',
                         'mimeOrExt', 'sizeBytes', 'notes', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'uriOrPath', 'linkType',
                         'mimeOrExt', 'sizeBytes', 'notes', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       isValidLinkedFile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(fileId) &&
                       isValidLinkedFile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'uriOrPath', 'linkType',
                         'mimeOrExt', 'sizeBytes', 'notes', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(fileId);
    }

    match /users/{userId}/generatedMedia/{mediaId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(mediaId);

      allow create: if isOwner(userId) &&
                       isValidId(mediaId) &&
                       incoming().keys().hasAll([
                         'userId', 'mediaUrl', 'mediaType', 'prompt', 'modelUsed',
                         'durationSec', 'sourceBotName', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'mediaUrl', 'mediaType', 'prompt', 'modelUsed',
                         'durationSec', 'sourceBotName', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       isValidGeneratedMedia(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(mediaId) &&
                       isValidGeneratedMedia(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'mediaUrl', 'mediaType', 'prompt', 'modelUsed', 'durationSec', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(mediaId);
    }

    match /users/{userId}/settings/{settingId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(settingId);

      allow create: if isOwner(userId) &&
                       isValidId(settingId) &&
                       incoming().keys().hasAll([
                         'userId', 'globalVeniceModel', 'veniceApiKeyOverride', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'globalVeniceModel', 'veniceApiKeyOverride', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       isValidUserPreferences(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(settingId) &&
                       isValidUserPreferences(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'globalVeniceModel', 'veniceApiKeyOverride', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(settingId);
    }

    match /users/{userId}/generalChats/{chatId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(chatId);

      allow create: if isOwner(userId) &&
                       isValidId(chatId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'pinned', 'lastMessagePreview',
                         'wheelModel', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'pinned', 'lastMessagePreview',
                         'wheelModel', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       isValidGeneralChat(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(chatId) &&
                       isValidGeneralChat(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'pinned', 'lastMessagePreview', 'wheelModel', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(chatId);

      match /messages/{messageId} {
        allow list: if isOwner(userId) && isValidId(chatId);
        allow get: if isOwner(userId) && isValidId(chatId) && isValidId(messageId);

        allow create: if isOwner(userId) &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/generalChats/$(chatId)) &&
                         incoming().keys().hasAll([
                           'userId', 'chatId', 'sender', 'rawText',
                           'modelLabel', 'status', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'chatId', 'sender', 'rawText',
                           'modelLabel', 'status', 'mediaUrl', 'mediaType',
                           'mediaPrompt', 'mediaModel', 'mediaDurationSec',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt) &&
                         isValidGeneralMessage(incoming(), userId, chatId);

        allow update: if isOwner(userId) &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         isValidGeneralMessage(incoming(), userId, chatId) &&
                         incoming().userId == existing().userId &&
                         incoming().chatId == existing().chatId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'rawText', 'modelLabel', 'status',
                           'mediaUrl', 'mediaType', 'mediaPrompt',
                           'mediaModel', 'mediaDurationSec', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(chatId) && isValidId(messageId);
      }
    }

    match /users/{userId}/contextChats/{chatId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(chatId);

      allow create: if isOwner(userId) &&
                       isValidId(chatId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'pinned', 'lastMessagePreview',
                         'wheelModel', 'docLabels', 'docRefs', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'pinned', 'lastMessagePreview',
                         'wheelModel', 'docLabels', 'docRefs', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       isValidContextChat(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(chatId) &&
                       isValidContextChat(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'pinned', 'lastMessagePreview', 'wheelModel',
                         'docLabels', 'docRefs', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(chatId);

      match /messages/{messageId} {
        allow list: if isOwner(userId) && isValidId(chatId);
        allow get: if isOwner(userId) && isValidId(chatId) && isValidId(messageId);

        allow create: if isOwner(userId) &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/contextChats/$(chatId)) &&
                         incoming().keys().hasAll([
                           'userId', 'chatId', 'sender', 'rawText',
                           'modelLabel', 'status', 'citedDocs', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'chatId', 'sender', 'rawText',
                           'modelLabel', 'status', 'citedDocs', 'mediaUrl', 'mediaType',
                           'mediaPrompt', 'mediaModel', 'mediaDurationSec',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt) &&
                         isValidContextMessage(incoming(), userId, chatId);

        allow update: if isOwner(userId) &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         isValidContextMessage(incoming(), userId, chatId) &&
                         incoming().userId == existing().userId &&
                         incoming().chatId == existing().chatId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'rawText', 'modelLabel', 'status', 'citedDocs',
                           'mediaUrl', 'mediaType', 'mediaPrompt',
                           'mediaModel', 'mediaDurationSec', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(chatId) && isValidId(messageId);
      }
    }
  }
}
